# Mock mode (set to "true" to use mock Supabase client without real credentials)
# EXPO_PUBLIC_USE_MOCK=true

# Demo/guest login (set to "true" to show guest login button)
# EXPO_PUBLIC_ENABLE_DEMO=true

# Supabase
# EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Maps API Key
# 以下のURLからAPIキーを取得してください:
# https://console.cloud.google.com/google/maps-apis/
# 必要なAPI: Maps JavaScript API, Places API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Contact form recipient (auth.users.id UUID)
# 未設定の場合、開発フォールバックとして送信者本人宛てに保存されます。
EXPO_PUBLIC_SUPPORT_USER_ID=00000000-0000-0000-0000-000000000000
